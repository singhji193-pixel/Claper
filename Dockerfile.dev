# Prebuilt Erlang/Elixir base; the previous asdf source build of Erlang was
# slow and failed intermittently on fresh machines.
FROM hexpm/elixir:1.18.4-erlang-28.0.1-ubuntu-noble-20260509.1

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    tzdata \
    build-essential \
    git \
    curl \
    wget \
    gnupg \
    ca-certificates \
    openssl \
    locales \
    inotify-tools \
    unzip \
    ghostscript \
    libreoffice \
    && ln -fs /usr/share/zoneinfo/UTC /etc/localtime \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Node.js 22 for esbuild/tailwind asset tooling
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force \
    && mix local.rebar --force

# custom ERL_FLAGS are passed for (public) multi-platform builds
ARG ERL_FLAGS
ENV ERL_FLAGS=$ERL_FLAGS

EXPOSE 4000
USER root
WORKDIR /app
ENTRYPOINT ["bash", "-c", "mix deps.get && mix ecto.migrate && cd assets && npm i && cd .. && mix phx.server"]
