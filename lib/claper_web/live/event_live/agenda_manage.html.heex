<div class="min-h-screen bg-gray-100">
  <div class="bg-white border-b border-gray-200">
    <div class="mx-auto max-w-6xl px-4 py-4">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="flex items-center gap-3">
          <a
            href={~p"/events"}
            class="rounded-md p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-700"
            aria-label={gettext("Back to events")}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
          <div>
            <p class="text-sm font-medium uppercase tracking-wide text-primary-600">
              {@event.code}
            </p>
            <h1 class="text-2xl font-bold text-gray-900">{gettext("Agenda")}</h1>
            <p class="mt-1 text-sm text-gray-500">{@event.name}</p>
          </div>
        </div>

        <div class="flex flex-col gap-2 sm:flex-row">
          <a
            href={~p"/e/#{@event.code}"}
            target="_blank"
            class="inline-flex items-center justify-center rounded-md border border-primary-500 px-4 py-2 text-sm font-semibold text-primary-600 hover:bg-primary-50"
          >
            {gettext("View attendee agenda")}
          </a>
          <a
            href={~p"/e/#{@event.code}/manage"}
            class="inline-flex items-center justify-center rounded-md bg-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-300"
          >
            {gettext("Event manager")}
          </a>
          <.link
            :if={@live_action == :index}
            patch={~p"/e/#{@event.code}/manage/agenda/new"}
            class="inline-flex items-center justify-center rounded-md bg-linear-to-tl from-primary-500 to-secondary-500 bg-size-[200%_200%] bg-position-[0%_0%] px-4 py-2 text-sm font-semibold text-white transition-all duration-500 hover:bg-position-[100%_100%]"
          >
            {gettext("New agenda item")}
          </.link>
        </div>
      </div>
    </div>
  </div>

  <main class="mx-auto max-w-6xl px-4 py-6">
    <%= if @live_action in [:new, :edit] && @form do %>
      <section class="mb-6 rounded-xl bg-white p-5 shadow-base">
        <div class="mb-5 flex items-center justify-between">
          <h2 class="text-xl font-semibold text-gray-900">{@page_title}</h2>
          <button
            type="button"
            phx-click="cancel"
            class="rounded-md px-3 py-2 text-sm font-semibold text-gray-500 hover:bg-gray-100"
          >
            {gettext("Cancel")}
          </button>
        </div>

        <.form for={@form} id="agenda-item-form" phx-change="validate" phx-submit="save">
          {hidden_input(@form, :position)}
          {hidden_input(@form, :event_id)}

          <div class="grid grid-cols-1 gap-5 md:grid-cols-6">
            <div class="md:col-span-3">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Time")}
              </label>
              {datetime_local_input(@form, :starts_at,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                required: true
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :starts_at)}</div>
            </div>

            <div class="md:col-span-3">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Duration")}
              </label>
              {number_input(@form, :duration_minutes,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                min: 1,
                max: 1440
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :duration_minutes)}</div>
            </div>

            <div class="md:col-span-6">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Session title")}
              </label>
              {text_input(@form, :title,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                required: true,
                maxlength: 255
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :title)}</div>
            </div>

            <div class="md:col-span-6">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Speaker")}
              </label>
              {text_input(@form, :speaker_name,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                maxlength: 255
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :speaker_name)}</div>
            </div>

            <div class="md:col-span-3">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Speaker title")}
              </label>
              {text_input(@form, :speaker_title,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                maxlength: 255
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :speaker_title)}</div>
            </div>

            <div class="md:col-span-3">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Speaker company")}
              </label>
              {text_input(@form, :speaker_company,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                maxlength: 255
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :speaker_company)}</div>
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Track")}
              </label>
              {text_input(@form, :track_name,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                maxlength: 120
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :track_name)}</div>
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Type")}
              </label>
              {text_input(@form, :session_type,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                maxlength: 120
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :session_type)}</div>
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Location")}
              </label>
              {text_input(@form, :location_name,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                maxlength: 255
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :location_name)}</div>
            </div>

            <div class="md:col-span-6">
              <label class="block text-sm font-semibold text-gray-700">
                {gettext("Description")}
              </label>
              {textarea(@form, :description,
                class:
                  "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                rows: 4
              )}
              <div class="mt-1 text-sm text-red-500">{error_tag(@form, :description)}</div>
            </div>
          </div>

          <div class="mt-6 flex justify-end">
            <button
              type="submit"
              phx-disable-with={gettext("Saving...")}
              class="inline-flex items-center justify-center rounded-md bg-primary-500 px-5 py-2 text-sm font-semibold text-white hover:bg-primary-600"
            >
              {if @live_action == :new,
                do: gettext("Create agenda item"),
                else: gettext("Update agenda item")}
            </button>
          </div>
        </.form>
      </section>
    <% end %>

    <section
      :if={@live_action == :edit && @resource_form}
      class="mb-6 rounded-lg border border-gray-200 bg-white p-5 shadow-sm"
    >
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-primary-600">
            {gettext("Session resources")}
          </p>
          <h2 class="text-xl font-semibold text-gray-900">
            {if @resource && @resource.id,
              do: gettext("Edit resource"),
              else: gettext("Add resource")}
          </h2>
          <p class="mt-1 text-sm leading-6 text-gray-500">
            {gettext("Publish HTTPS links to slides, PDFs, recordings, or supporting material.")}
          </p>
        </div>
        <button
          :if={@resource && @resource.id}
          type="button"
          phx-click="cancel-resource"
          class="min-h-11 rounded-md px-3 text-sm font-semibold text-gray-600 hover:bg-gray-100"
        >
          {gettext("Cancel edit")}
        </button>
      </div>

      <.form
        for={@resource_form}
        id="agenda-resource-form"
        phx-change="validate-resource"
        phx-submit="save-resource"
        class="mt-5 grid gap-4 md:grid-cols-6"
      >
        {hidden_input(@resource_form, :event_id)}
        {hidden_input(@resource_form, :agenda_item_id)}
        {hidden_input(@resource_form, :position)}

        <div class="md:col-span-3">
          <label class="block text-sm font-semibold text-gray-700">{gettext("Title")}</label>
          {text_input(@resource_form, :title,
            required: true,
            maxlength: 120,
            class:
              "mt-2 block min-h-11 w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
          )}
          <div class="mt-1 text-sm text-red-600">{error_tag(@resource_form, :title)}</div>
        </div>

        <div class="md:col-span-3">
          <label class="block text-sm font-semibold text-gray-700">{gettext("Type")}</label>
          {select(
            @resource_form,
            :kind,
            [
              {gettext("Link"), "link"},
              {gettext("PDF"), "pdf"},
              {gettext("Slides"), "slides"},
              {gettext("Recording"), "recording"}
            ],
            class:
              "mt-2 block min-h-11 w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
          )}
          <div class="mt-1 text-sm text-red-600">{error_tag(@resource_form, :kind)}</div>
        </div>

        <div class="md:col-span-6">
          <label class="block text-sm font-semibold text-gray-700">{gettext("HTTPS URL")}</label>
          {url_input(@resource_form, :url,
            required: true,
            maxlength: 2048,
            placeholder: "https://",
            class:
              "mt-2 block min-h-11 w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
          )}
          <div class="mt-1 text-sm text-red-600">{error_tag(@resource_form, :url)}</div>
        </div>

        <label class="flex min-h-11 items-center gap-3 md:col-span-3">
          {checkbox(@resource_form, :published,
            class: "h-5 w-5 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
          )}
          <span class="text-sm font-semibold text-gray-700">
            {gettext("Published to attendees")}
          </span>
        </label>

        <div class="flex items-center md:col-span-3 md:justify-end">
          <button
            type="submit"
            phx-disable-with={gettext("Saving...")}
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-primary-500 px-5 py-2 text-sm font-semibold text-white hover:bg-primary-600"
          >
            {if @resource && @resource.id,
              do: gettext("Update resource"),
              else: gettext("Add resource")}
          </button>
        </div>
      </.form>

      <div
        :if={!Enum.empty?(@resources)}
        class="mt-6 divide-y divide-gray-200 border-t border-gray-200"
      >
        <article
          :for={{resource, index} <- Enum.with_index(@resources)}
          id={"agenda-resource-#{resource.id}"}
          class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <strong class="text-sm text-gray-900">{resource.title}</strong>
              <span class="rounded-full bg-gray-100 px-2 py-1 text-xs font-semibold uppercase text-gray-600">
                {resource.kind}
              </span>
              <span class={[
                "rounded-full px-2 py-1 text-xs font-semibold",
                resource.published && "bg-emerald-50 text-emerald-700",
                !resource.published && "bg-amber-50 text-amber-700"
              ]}>
                {if resource.published, do: gettext("Published"), else: gettext("Draft")}
              </span>
            </div>
            <p class="mt-1 truncate text-sm text-gray-500">{resource.url}</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              phx-click="move-resource"
              phx-value-id={resource.id}
              phx-value-direction="up"
              disabled={index == 0}
              class="min-h-11 rounded-md bg-gray-100 px-3 text-sm font-semibold text-gray-600 disabled:opacity-40"
              title={gettext("Move up")}
            >
              {gettext("Up")}
            </button>
            <button
              type="button"
              phx-click="move-resource"
              phx-value-id={resource.id}
              phx-value-direction="down"
              disabled={index == length(@resources) - 1}
              class="min-h-11 rounded-md bg-gray-100 px-3 text-sm font-semibold text-gray-600 disabled:opacity-40"
              title={gettext("Move down")}
            >
              {gettext("Down")}
            </button>
            <button
              type="button"
              phx-click="edit-resource"
              phx-value-id={resource.id}
              class="min-h-11 rounded-md px-3 text-sm font-semibold text-primary-700 hover:bg-primary-50"
            >
              {gettext("Edit")}
            </button>
            <button
              type="button"
              phx-click="delete-resource"
              phx-value-id={resource.id}
              data-confirm={gettext("Delete this resource?")}
              class="min-h-11 rounded-md px-3 text-sm font-semibold text-red-600 hover:bg-red-50"
            >
              {gettext("Delete")}
            </button>
          </div>
        </article>
      </div>
    </section>

    <section class="overflow-hidden rounded-xl bg-white shadow-base">
      <%= if Enum.empty?(@agenda_items) do %>
        <div class="p-8 text-center">
          <p class="text-lg font-semibold text-gray-700">{gettext("No agenda items yet")}</p>
          <p class="mt-2 text-sm text-gray-500">
            {gettext("Create the first agenda item for this event.")}
          </p>
        </div>
      <% else %>
        <div class="divide-y divide-gray-200">
          <%= for {agenda_item, index} <- Enum.with_index(@agenda_items) do %>
            <article id={"agenda-item-#{agenda_item.id}"} class="p-5">
              <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
                    <span class="rounded-full bg-primary-100 px-2 py-0.5 font-semibold text-primary-700">
                      {index + 1}
                    </span>
                    <time>{format_agenda_time(agenda_item.starts_at, @timezone)}</time>
                    <span :if={agenda_item.duration_minutes}>&middot;</span>
                    <span :if={agenda_item.duration_minutes}>
                      {format_duration(agenda_item.duration_minutes)}
                    </span>
                  </div>
                  <h2 class="mt-2 text-lg font-semibold text-gray-900">{agenda_item.title}</h2>
                  <p
                    :if={agenda_item.speaker_name}
                    class="mt-1 text-sm font-medium text-primary-700"
                  >
                    {agenda_item.speaker_name}
                  </p>
                  <p
                    :if={agenda_item.location_name || agenda_item.track_name}
                    class="mt-1 text-sm text-gray-500"
                  >
                    {Enum.reject([agenda_item.track_name, agenda_item.location_name], &is_nil/1)
                    |> Enum.join(" · ")}
                  </p>
                  <p
                    :if={agenda_item.description}
                    class="mt-3 whitespace-pre-line text-sm leading-6 text-gray-600"
                  >
                    {agenda_item.description}
                  </p>
                </div>

                <div class="flex shrink-0 flex-wrap items-center gap-2">
                  <button
                    type="button"
                    phx-click="move"
                    phx-value-id={agenda_item.id}
                    phx-value-direction="up"
                    disabled={index == 0}
                    class="rounded-md bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-40"
                    title={gettext("Move up")}
                  >
                    &uarr;
                  </button>
                  <button
                    type="button"
                    phx-click="move"
                    phx-value-id={agenda_item.id}
                    phx-value-direction="down"
                    disabled={index == length(@agenda_items) - 1}
                    class="rounded-md bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-200 disabled:cursor-not-allowed disabled:opacity-40"
                    title={gettext("Move down")}
                  >
                    &darr;
                  </button>
                  <.link
                    patch={~p"/e/#{@event.code}/manage/agenda/#{agenda_item}/edit"}
                    class="rounded-md px-3 py-2 text-sm font-semibold text-primary-600 hover:bg-primary-50"
                  >
                    {gettext("Edit")}
                  </.link>
                  <button
                    type="button"
                    phx-click="delete"
                    phx-value-id={agenda_item.id}
                    data-confirm={gettext("Are you sure you want to delete this agenda item?")}
                    class="rounded-md px-3 py-2 text-sm font-semibold text-red-500 hover:bg-red-50"
                  >
                    {gettext("Delete")}
                  </button>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>
    </section>
  </main>
</div>
