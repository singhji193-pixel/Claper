<div class="relative min-h-screen bg-gray-100 lg:flex lg:flex-col lg:items-center">
  <div class="relative w-full">
    <div
      id="side-menu-shadow"
      phx-click={toggle_side_menu()}
      class="hidden fixed z-20 h-screen bg-black/70 w-full"
    >
    </div>

    <div
      id="side-menu"
      class="hidden fixed h-screen w-64 bg-white rounded-r-lg flex z-30 px-4 flex-col justify-start lg:left-0 animate__faster"
    >
      <div>
        <img src="/images/hq-logo.png" class="h-20 my-3" />
        <span class="font-bold text-xl">{@event.name}</span>
      </div>

      <a
        class="flex items-center px-3 py-2 bg-primary-100 text-primary-800 rounded-lg mt-5"
        href={~p"/e/#{@event.code}/bingo"}
      >
        <span class="mr-3 text-lg font-bold">B</span>
        <span>{gettext("Bingo")}</span>
      </a>

      <a
        class="flex items-center px-3 py-2 bg-gray-200 rounded-lg mt-3"
        href={~p"/e/#{@event.code}/agenda"}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          class="mr-3 h-5 w-5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.75 3v2.25m10.5-2.25v2.25M3.75 9h16.5m-15.75-4.5h15A1.5 1.5 0 0 1 21 6v13.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19.5V6A1.5 1.5 0 0 1 4.5 4.5Z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M7.5 12.75h.008v.008H7.5v-.008Zm4.5 0h.008v.008H12v-.008Zm4.5 0h.008v.008H16.5v-.008ZM7.5 16.5h.008v.008H7.5V16.5Zm4.5 0h.008v.008H12V16.5Zm4.5 0h.008v.008H16.5V16.5Z"
          />
        </svg>
        <span>{gettext("Agenda")}</span>
      </a>

      <a
        class="flex items-center px-3 py-2 bg-gray-200 rounded-lg mt-3"
        href={~p"/e/#{@event.code}"}
      >
        <span class="mr-3 text-lg font-bold">&larr;</span>
        <span>{gettext("Back to event")}</span>
      </a>

      <a
        class="flex items-center px-3 py-2 bg-gray-200 rounded-lg mt-3"
        href={~p"/?disconnected_from=#{@event.uuid}"}
      >
        <img src="/images/icons/exit-outline.svg" class="h-5 mr-3" />
        <span>{gettext("Leave")}</span>
      </a>
    </div>
  </div>

  <div
    id="content"
    class="w-full bg-black fixed z-10 lg:w-1/3"
    style="box-shadow: 0px 15px 14px 1px rgba(0,0,0,0.35);"
  >
    <div class="flex justify-between items-center px-5 py-3">
      <button
        phx-click={toggle_side_menu()}
        class="bg-black rounded-full text-sm px-3 py-1 bg-linear-to-tl from-primary-500 to-secondary-500 bg-size-[200%_200%] bg-position-[0%_0%] text-white uppercase flex items-center"
      >
        <img src="/images/icons/menu-outline.svg" class="h-6" />
        <span class="ml-1">#{@event.code}</span>
      </button>

      <span class="text-white text-sm font-semibold">{gettext("Bingo")}</span>
    </div>
  </div>

  <main class="w-full px-4 pb-10 pt-20 lg:w-1/3">
    <header class="rounded-lg bg-white p-5 shadow-sm">
      <p class="text-sm text-gray-500">{@event.name}</p>
      <div class="mt-1 flex items-end justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">{gettext("Bingo")}</h1>
          <p :if={@player} class="mt-1 text-sm text-gray-500">
            {@progress_count}/{length(@prompts)} {gettext("prompts complete")}
          </p>
        </div>
        <div :if={@player} class="rounded-md bg-gray-100 px-3 py-2 text-right">
          <p class="text-xs font-semibold uppercase text-gray-500">{gettext("Code")}</p>
          <p class="text-base font-bold tracking-widest text-gray-900">{@player.code}</p>
        </div>
      </div>
    </header>

    <%= if Enum.empty?(@prompts) do %>
      <section class="mt-4 rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center">
        <p class="font-semibold text-gray-700">{gettext("Bingo is not ready yet")}</p>
        <p class="mt-2 text-sm text-gray-500">
          {gettext("Prompts will appear here when the organizer adds them.")}
        </p>
      </section>
    <% else %>
      <%= if is_nil(@player) do %>
        <section class="mt-4 rounded-lg bg-white p-5 shadow-sm">
          <p class="text-sm text-gray-600">
            {gettext("Choose the name other attendees will see when you connect.")}
          </p>
          <.form for={@player_form} id="bingo-player-form" phx-submit="save-player" class="mt-4">
            <label class="block text-sm font-semibold text-gray-700">
              {gettext("Your name")}
            </label>
            {text_input(@player_form, :name,
              class:
                "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
              required: true,
              maxlength: 40
            )}
            <div class="mt-1 text-sm text-red-500">{error_tag(@player_form, :name)}</div>
            <button
              type="submit"
              phx-disable-with={gettext("Saving...")}
              class="mt-4 inline-flex w-full items-center justify-center rounded-md bg-primary-500 px-5 py-2 text-sm font-semibold text-white hover:bg-primary-600"
            >
              {gettext("Start Bingo")}
            </button>
          </.form>
        </section>
      <% else %>
        <nav class="mt-4 flex gap-2 overflow-x-auto pb-1">
          <%= for {tab, label} <- tabs(@settings) do %>
            <button
              type="button"
              phx-click="set-tab"
              phx-value-tab={tab}
              class={tab_button_class(tab, @active_tab)}
            >
              {label}
            </button>
          <% end %>
        </nav>

        <%= if @active_tab == "play" do %>
          <section class="mt-4 rounded-lg bg-white p-5 shadow-sm">
            <div class="rounded-lg bg-gray-50 p-4">
              <div class="flex items-center justify-between text-sm">
                <span class="font-semibold text-gray-700">{@player.name}</span>
                <span class="text-gray-500">
                  {@progress_count}/{length(@prompts)}
                </span>
              </div>
              <div class="mt-3 h-2 overflow-hidden rounded-full bg-gray-200">
                <div
                  class="h-2 rounded-full bg-primary-500"
                  style={"width: #{round(@progress_count / length(@prompts) * 100)}%;"}
                >
                </div>
              </div>
            </div>

            <%= if @current_prompt do %>
              <article class="mt-5 rounded-lg border border-primary-100 bg-primary-50 p-4">
                <p class="text-xs font-semibold uppercase text-primary-700">
                  {gettext("Current prompt")}
                </p>
                <p class="mt-2 whitespace-pre-line text-lg font-semibold leading-7 text-gray-900">
                  {@current_prompt.prompt}
                </p>
              </article>

              <div class="mt-5 rounded-lg border border-gray-200 p-4 text-center">
                <p class="text-sm font-semibold text-gray-700">{gettext("Your code")}</p>
                <div
                  id="bingo-player-qr"
                  phx-hook="QRCode"
                  phx-update="ignore"
                  data-url={@player.code}
                  data-size="208"
                  class="mx-auto mt-4 flex h-56 w-56 items-center justify-center rounded-lg bg-white p-2"
                >
                </div>
                <p class="mt-3 text-2xl font-bold tracking-widest text-gray-900">
                  {@player.code}
                </p>
              </div>

              <div class="mt-5">
                <.form for={@connection_form} id="bingo-connection-form" phx-submit="connect">
                  <label class="block text-sm font-semibold text-gray-700">
                    {gettext("Enter another attendee code")}
                  </label>
                  <div class="mt-2 flex gap-2">
                    {text_input(@connection_form, :code,
                      class:
                        "block min-w-0 flex-1 rounded-md border-gray-300 uppercase shadow-sm focus:border-primary-500 focus:ring-primary-500",
                      autocomplete: "off"
                    )}
                    <button
                      type="submit"
                      phx-disable-with={gettext("Saving...")}
                      class="rounded-md bg-primary-500 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-600"
                    >
                      {gettext("Connect")}
                    </button>
                  </div>
                </.form>

                <div class="mt-5 rounded-lg border border-gray-200 p-3">
                  <p class="mb-3 text-sm font-semibold text-gray-700">
                    {gettext("Scan a Bingo QR")}
                  </p>
                  <div id="bingo-scanner" phx-hook="BingoScanner" phx-update="ignore"></div>
                </div>
              </div>
            <% else %>
              <div class="mt-5 rounded-lg border border-green-200 bg-green-50 p-6 text-center">
                <p class="text-lg font-semibold text-green-800">{gettext("Bingo complete")}</p>
                <p class="mt-2 text-sm text-green-700">
                  {gettext("You have completed every prompt for this event.")}
                </p>
              </div>
            <% end %>
          </section>
        <% end %>

        <%= if @active_tab == "connections" do %>
          <section class="mt-4 rounded-lg bg-white p-5 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-900">{gettext("Connections")}</h2>
            <%= if Enum.empty?(@connection_profiles) do %>
              <p class="mt-3 rounded-lg border border-dashed border-gray-300 p-4 text-sm text-gray-500">
                {gettext("Connections will appear here after you scan or enter attendee codes.")}
              </p>
            <% else %>
              <div class="mt-4 space-y-3">
                <%= for connection <- @connection_profiles do %>
                  <% profile = connection.profile %>
                  <article class="rounded-lg border border-gray-200 p-4">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <h3 class="font-semibold text-gray-900">{profile.name}</h3>
                        <p
                          :if={Map.get(profile, :title) || Map.get(profile, :company)}
                          class="mt-1 text-sm text-gray-500"
                        >
                          {[Map.get(profile, :title), Map.get(profile, :company)]
                          |> Enum.reject(&is_nil/1)
                          |> Enum.reject(&(&1 == ""))
                          |> Enum.join(" at ")}
                        </p>
                      </div>
                      <time class="text-xs text-gray-400">
                        {format_bingo_time(connection.connected_at)}
                      </time>
                    </div>

                    <p class="mt-3 rounded-md bg-gray-50 p-3 text-sm text-gray-600">
                      {connection.prompt}
                    </p>
                    <p :if={Map.get(profile, :intro)} class="mt-3 text-sm text-gray-700">
                      {profile.intro}
                    </p>

                    <div class="mt-3 space-y-1 text-sm">
                      <a
                        :if={Map.get(profile, :email)}
                        class="block break-all text-primary-700"
                        href={"mailto:#{profile.email}"}
                      >
                        {profile.email}
                      </a>
                      <a
                        :if={Map.get(profile, :phone)}
                        class="block break-all text-primary-700"
                        href={"tel:#{profile.phone}"}
                      >
                        {profile.phone}
                      </a>
                      <a
                        :if={Map.get(profile, :linkedin_url)}
                        class="block break-all text-primary-700"
                        href={profile.linkedin_url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {profile.linkedin_url}
                      </a>
                      <a
                        :if={Map.get(profile, :website_url)}
                        class="block break-all text-primary-700"
                        href={profile.website_url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {profile.website_url}
                      </a>
                    </div>
                  </article>
                <% end %>
              </div>
            <% end %>
          </section>
        <% end %>

        <%= if @active_tab == "people" do %>
          <section class="mt-4 rounded-lg bg-white p-5 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-900">{gettext("People")}</h2>
            <%= if !@settings.forum_enabled do %>
              <p class="mt-3 rounded-lg border border-dashed border-gray-300 p-4 text-sm text-gray-500">
                {gettext("Introductions are turned off for this event.")}
              </p>
            <% else %>
              <%= if Enum.empty?(@forum_players) do %>
                <p class="mt-3 rounded-lg border border-dashed border-gray-300 p-4 text-sm text-gray-500">
                  {gettext("Attendee introductions will appear here.")}
                </p>
              <% else %>
                <div class="mt-4 space-y-3">
                  <%= for person <- @forum_players do %>
                    <article class="rounded-lg border border-gray-200 p-4">
                      <h3 class="font-semibold text-gray-900">
                        {person.name}
                        <span
                          :if={person.id == @player.id}
                          class="ml-2 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500"
                        >
                          {gettext("You")}
                        </span>
                      </h3>
                      <p :if={person.title || person.company} class="mt-1 text-sm text-gray-500">
                        {[person.title, person.company]
                        |> Enum.reject(&is_nil/1)
                        |> Enum.reject(&(&1 == ""))
                        |> Enum.join(" at ")}
                      </p>
                      <p
                        :if={person.intro}
                        class="mt-3 whitespace-pre-line text-sm leading-6 text-gray-700"
                      >
                        {person.intro}
                      </p>
                    </article>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </section>
        <% end %>

        <%= if @active_tab == "profile" do %>
          <section class="mt-4 rounded-lg bg-white p-5 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-900">{gettext("Bingo profile")}</h2>
            <.form
              for={@profile_form}
              id="bingo-profile-form"
              phx-submit="save-profile"
              class="mt-4 space-y-4"
            >
              <div>
                <label class="block text-sm font-semibold text-gray-700">{gettext("Name")}</label>
                {text_input(@profile_form, :name,
                  class:
                    "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                  required: true,
                  maxlength: 40
                )}
                <div class="mt-1 text-sm text-red-500">{error_tag(@profile_form, :name)}</div>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="block text-sm font-semibold text-gray-700">
                    {gettext("Title")}
                  </label>
                  {text_input(@profile_form, :title,
                    class:
                      "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                    maxlength: 80
                  )}
                  <label class="mt-2 flex items-center gap-2 text-xs text-gray-500">
                    {checkbox(@profile_form, :share_title,
                      class: "h-4 w-4 rounded border-gray-300 text-primary-600"
                    )}
                    {gettext("Share with connections")}
                  </label>
                </div>

                <div>
                  <label class="block text-sm font-semibold text-gray-700">
                    {gettext("Company")}
                  </label>
                  {text_input(@profile_form, :company,
                    class:
                      "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                    maxlength: 80
                  )}
                  <label class="mt-2 flex items-center gap-2 text-xs text-gray-500">
                    {checkbox(@profile_form, :share_company,
                      class: "h-4 w-4 rounded border-gray-300 text-primary-600"
                    )}
                    {gettext("Share with connections")}
                  </label>
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700">
                  {gettext("Introduction")}
                </label>
                {textarea(@profile_form, :intro,
                  class:
                    "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                  rows: 4,
                  maxlength: 280
                )}
                <div class="mt-1 text-sm text-red-500">{error_tag(@profile_form, :intro)}</div>
                <label class="mt-2 flex items-center gap-2 text-xs text-gray-500">
                  {checkbox(@profile_form, :share_intro,
                    class: "h-4 w-4 rounded border-gray-300 text-primary-600"
                  )}
                  {gettext("Share with connections")}
                </label>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="block text-sm font-semibold text-gray-700">
                    {gettext("Email")}
                  </label>
                  {email_input(@profile_form, :email,
                    class:
                      "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                    maxlength: 120
                  )}
                  <div class="mt-1 text-sm text-red-500">{error_tag(@profile_form, :email)}</div>
                  <label class="mt-2 flex items-center gap-2 text-xs text-gray-500">
                    {checkbox(@profile_form, :share_email,
                      class: "h-4 w-4 rounded border-gray-300 text-primary-600"
                    )}
                    {gettext("Share with connections")}
                  </label>
                </div>

                <div>
                  <label class="block text-sm font-semibold text-gray-700">
                    {gettext("Phone")}
                  </label>
                  {text_input(@profile_form, :phone,
                    class:
                      "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                    maxlength: 40
                  )}
                  <label class="mt-2 flex items-center gap-2 text-xs text-gray-500">
                    {checkbox(@profile_form, :share_phone,
                      class: "h-4 w-4 rounded border-gray-300 text-primary-600"
                    )}
                    {gettext("Share with connections")}
                  </label>
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700">
                  {gettext("LinkedIn URL")}
                </label>
                {text_input(@profile_form, :linkedin_url,
                  class:
                    "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                  maxlength: 255
                )}
                <div class="mt-1 text-sm text-red-500">
                  {error_tag(@profile_form, :linkedin_url)}
                </div>
                <label class="mt-2 flex items-center gap-2 text-xs text-gray-500">
                  {checkbox(@profile_form, :share_linkedin_url,
                    class: "h-4 w-4 rounded border-gray-300 text-primary-600"
                  )}
                  {gettext("Share with connections")}
                </label>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700">
                  {gettext("Website URL")}
                </label>
                {text_input(@profile_form, :website_url,
                  class:
                    "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500",
                  maxlength: 255
                )}
                <div class="mt-1 text-sm text-red-500">
                  {error_tag(@profile_form, :website_url)}
                </div>
                <label class="mt-2 flex items-center gap-2 text-xs text-gray-500">
                  {checkbox(@profile_form, :share_website_url,
                    class: "h-4 w-4 rounded border-gray-300 text-primary-600"
                  )}
                  {gettext("Share with connections")}
                </label>
              </div>

              <button
                type="submit"
                phx-disable-with={gettext("Saving...")}
                class="inline-flex w-full items-center justify-center rounded-md bg-primary-500 px-5 py-2 text-sm font-semibold text-white hover:bg-primary-600"
              >
                {gettext("Save profile")}
              </button>
            </.form>
          </section>
        <% end %>

        <%= if @active_tab == "leaderboard" && @settings.leaderboard_enabled do %>
          <section class="mt-4 rounded-lg bg-white p-5 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-900">{gettext("Leaderboard")}</h2>
            <div class="mt-4 divide-y divide-gray-200 overflow-hidden rounded-lg border border-gray-200">
              <%= for {row, index} <- Enum.with_index(@leaderboard, 1) do %>
                <div class="flex items-center justify-between gap-3 p-3">
                  <div class="flex min-w-0 items-center gap-3">
                    <span class="flex h-8 w-8 items-center justify-center rounded-md bg-gray-100 text-sm font-bold text-gray-700">
                      {index}
                    </span>
                    <span class="truncate font-semibold text-gray-900">{row.name}</span>
                  </div>
                  <span class="text-sm text-gray-500">
                    {row.completed_prompts}/{row.total_prompts}
                  </span>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      <% end %>
    <% end %>
  </main>
</div>
