<div class="min-h-screen bg-slate-50 font-sans text-slate-950 antialiased">
  <div class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-5 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-primary-600">
          {@event.code}
        </p>
        <h1 class="text-2xl font-bold text-slate-950">{gettext("Event app integrations")}</h1>
        <p class="mt-1 text-sm text-slate-500">{@event.name}</p>
      </div>

      <div class="flex flex-col gap-2 sm:flex-row">
        <a
          href={@app_url}
          target="_blank"
          class="inline-flex min-h-11 items-center justify-center rounded-lg border border-primary-500 px-4 py-2 text-sm font-semibold text-primary-700 transition hover:bg-primary-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
        >
          {gettext("Preview app")}
        </a>
        <a
          href={~p"/e/#{@event.code}/manage"}
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-500"
        >
          {gettext("Event manager")}
        </a>
      </div>
    </div>
  </div>

  <main class="mx-auto max-w-6xl px-4 py-6">
    <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          {gettext("Connection")}
        </p>
        <p class={[
          "mt-2 text-lg font-bold",
          integration_saved?(@integration) && @integration.enabled && "text-emerald-700",
          (!integration_saved?(@integration) || !@integration.enabled) && "text-slate-900"
        ]}>
          <%= cond do %>
            <% !integration_saved?(@integration) -> %>
              {gettext("Not set")}
            <% @integration.enabled -> %>
              {gettext("Active")}
            <% true -> %>
              {gettext("Paused")}
          <% end %>
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          {gettext("Orders")}
        </p>
        <p class="mt-2 text-2xl font-bold text-slate-950">{@stats.order_count}</p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          {gettext("Tickets")}
        </p>
        <p class="mt-2 text-2xl font-bold text-slate-950">{@stats.ticket_count}</p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          {gettext("Checked in")}
        </p>
        <p class="mt-2 text-2xl font-bold text-slate-950">{@stats.checked_in_count}</p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          {gettext("Last sync")}
        </p>
        <p class="mt-2 text-sm font-semibold leading-6 text-slate-950">
          {format_sync_time(@integration.last_received_at)}
        </p>
      </div>
    </section>

    <section class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_24rem]">
      <div class="rounded-lg border border-slate-200 bg-white p-5">
        <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-primary-600">
              {gettext("Hi.Events")}
            </p>
            <h2 class="text-xl font-bold text-slate-950">{gettext("Realtime ticket sync")}</h2>
            <p class="mt-1 max-w-2xl text-sm leading-6 text-slate-500">
              {gettext(
                "Connect the self-hosted Hi.Events event webhook here. Claper will keep a local ticket and check-in read model for attendee login, profiles, and future people search."
              )}
            </p>
          </div>
        </div>

        <.form
          for={@form}
          id="hi-events-integration-form"
          phx-change="validate"
          phx-submit="save"
          class="mt-5 space-y-5"
        >
          {hidden_input(@form, :event_id)}

          <div>
            <label
              for={@form[:external_event_id].id}
              class="block text-sm font-semibold text-slate-800"
            >
              {gettext("Hi.Events event ID")}
            </label>
            <input
              id={@form[:external_event_id].id}
              name={@form[:external_event_id].name}
              value={Phoenix.HTML.Form.input_value(@form, :external_event_id)}
              type="text"
              required
              placeholder="event_123 or your Hi.Events event UUID"
              class="mt-2 block min-h-11 w-full rounded-lg border-slate-300 text-base shadow-sm focus:border-primary-500 focus:ring-primary-500"
            />
            <p class="mt-2 text-sm leading-6 text-slate-500">
              {gettext(
                "Use the event identifier sent by Hi.Events. If your payload includes event.id, use that same value here."
              )}
            </p>
            <div class="mt-1 text-sm text-red-600">{error_tag(@form, :external_event_id)}</div>
          </div>

          <label class="flex min-h-11 items-start gap-3 rounded-lg border border-slate-200 p-3">
            {checkbox(@form, :enabled,
              class:
                "mt-1 h-5 w-5 rounded border-slate-300 text-primary-600 focus:ring-primary-500"
            )}
            <span>
              <span class="block text-sm font-semibold text-slate-800">
                {gettext("Accept incoming webhooks")}
              </span>
              <span class="block text-sm leading-6 text-slate-500">
                {gettext("Pause this if you need to stop sync without deleting the mapping.")}
              </span>
            </span>
          </label>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <button
              type="submit"
              phx-disable-with={gettext("Saving...")}
              class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary-500 px-5 py-2 text-sm font-semibold text-white transition hover:bg-primary-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
            >
              {gettext("Save integration")}
            </button>
            <p class="text-sm text-slate-500">
              {gettext("Secret and delivery history stay server-side in Claper.")}
            </p>
          </div>
        </.form>

        <div class="mt-6 border-t border-slate-200 pt-5">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-sm font-semibold text-slate-900">
                {gettext("Current ticket import")}
              </p>
              <p class="mt-1 text-sm leading-6 text-slate-500">
                <%= if @integration.last_reconciled_at do %>
                  {gettext("Last reconciled %{time}",
                    time: format_sync_time(@integration.last_reconciled_at)
                  )}
                <% else %>
                  {gettext(
                    "Import existing orders and attendees, then reconcile every 15 minutes."
                  )}
                <% end %>
              </p>
            </div>
            <button
              type="button"
              phx-click="sync-tickets"
              phx-disable-with={gettext("Queueing...")}
              disabled={!integration_saved?(@integration) || !@sync_available}
              class="inline-flex min-h-11 items-center justify-center rounded-lg bg-slate-950 px-5 py-2 text-sm font-semibold text-white transition hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-700 disabled:cursor-not-allowed disabled:bg-slate-300"
            >
              {gettext("Sync existing tickets")}
            </button>
          </div>
          <p :if={!@sync_available} class="mt-3 text-sm font-medium text-amber-700">
            {gettext("Server credentials must be configured before ticket import can run.")}
          </p>
        </div>
      </div>

      <aside class="rounded-lg border border-slate-200 bg-white p-5">
        <h2 class="text-xl font-bold text-slate-950">{gettext("Webhook setup")}</h2>
        <div class="mt-4 space-y-4">
          <div>
            <p class="text-sm font-semibold text-slate-800">{gettext("Endpoint URL")}</p>
            <code class="mt-2 block break-all rounded-lg bg-slate-100 p-3 text-xs leading-5 text-slate-800">
              {@webhook_url}
            </code>
          </div>

          <div :if={integration_saved?(@integration)}>
            <p class="text-sm font-semibold text-slate-800">{gettext("Managed automatically")}</p>
            <p class="mt-1 text-sm leading-6 text-slate-500">
              <%= if @integration.remote_webhook_id do %>
                {gettext("Connected to Hi.Events webhook %{id}",
                  id: @integration.remote_webhook_id
                )}
              <% else %>
                {gettext("The first ticket sync will create and secure the native webhook.")}
              <% end %>
            </p>
          </div>

          <div
            :if={!integration_saved?(@integration)}
            class="rounded-lg border border-dashed border-slate-300 p-4"
          >
            <p class="text-sm font-semibold text-slate-800">{gettext("Save first")}</p>
            <p class="mt-1 text-sm leading-6 text-slate-500">
              {gettext(
                "Add the Hi.Events event ID to generate the secret used for signature checks."
              )}
            </p>
          </div>

          <div>
            <p class="text-sm font-semibold text-slate-800">{gettext("Native verification")}</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              {gettext(
                "Hi.Events signs the raw request body in the Signature header. The secret is stored server-side and never rendered here."
              )}
            </p>
          </div>

          <div class="rounded-lg bg-primary-50 p-4 text-sm leading-6 text-primary-900">
            {gettext(
              "Orders, attendees, refunds, cancellations, and check-ins are subscribed automatically."
            )}
          </div>
        </div>
      </aside>
    </section>

    <section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
      <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="text-xl font-bold text-slate-950">{gettext("Recent deliveries")}</h2>
          <p class="mt-1 text-sm text-slate-500">
            {gettext("Retries with the same delivery ID are accepted once and then ignored.")}
          </p>
        </div>
        <p
          :if={@stats.failed_count > 0}
          class="rounded-lg bg-red-50 px-3 py-2 text-sm font-semibold text-red-700"
        >
          {gettext("%{count} failed", count: @stats.failed_count)}
        </p>
      </div>

      <%= if Enum.empty?(@stats.recent_events) do %>
        <div class="mt-5 rounded-lg border border-dashed border-slate-300 p-8 text-center">
          <p class="text-lg font-semibold text-slate-800">
            {gettext("No webhook deliveries yet")}
          </p>
          <p class="mt-2 text-sm leading-6 text-slate-500">
            {gettext("Send a test order from Hi.Events after saving the integration.")}
          </p>
        </div>
      <% else %>
        <div class="mt-5 divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200">
          <article :for={delivery <- @stats.recent_events} class="p-4">
            <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={[
                    "inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset",
                    status_badge_class(delivery.status)
                  ]}>
                    {delivery.status}
                  </span>
                  <p class="text-sm font-semibold text-slate-900">
                    {delivery.external_event_type}
                  </p>
                </div>
                <p class="mt-2 break-all text-xs leading-5 text-slate-500">
                  {delivery.external_event_key}
                </p>
                <p :if={delivery.error} class="mt-2 text-sm leading-6 text-red-600">
                  {delivery.error}
                </p>
              </div>
              <time class="text-sm text-slate-500">{format_sync_time(delivery.received_at)}</time>
            </div>
          </article>
        </div>
      <% end %>
    </section>
  </main>
</div>
