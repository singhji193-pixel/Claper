<div class="relative min-h-screen bg-black lg:flex lg:flex-col lg:items-center lg:bg-linear-to-tl lg:from-primary-500 lg:to-secondary-500">
  <div class="relative w-full">
    <div
      id="side-menu-shadow"
      phx-click={toggle_side_menu()}
      class="hidden fixed z-20 h-screen bg-black/70 w-full"
    >
    </div>

    <div
      id="side-menu"
      class="hidden fixed h-screen w-64 bg-white rounded-r-lg flex z-30 px-4 flex-col justify-start lg:left-0 animate__faster"
    >
      <div>
        <img src="/images/hq-logo.png" class="h-20 my-3" />
        <span class="font-bold text-xl">{@event.name}</span>
      </div>

      <a
        class="flex items-center px-3 py-2 bg-primary-100 text-primary-800 rounded-lg mt-5"
        href={~p"/e/#{@event.code}/agenda"}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          class="mr-3 h-5 w-5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.75 3v2.25m10.5-2.25v2.25M3.75 9h16.5m-15.75-4.5h15A1.5 1.5 0 0 1 21 6v13.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19.5V6A1.5 1.5 0 0 1 4.5 4.5Z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M7.5 12.75h.008v.008H7.5v-.008Zm4.5 0h.008v.008H12v-.008Zm4.5 0h.008v.008H16.5v-.008ZM7.5 16.5h.008v.008H7.5V16.5Zm4.5 0h.008v.008H12V16.5Zm4.5 0h.008v.008H16.5V16.5Z"
          />
        </svg>
        <span>{gettext("Agenda")}</span>
      </a>

      <a
        class="flex items-center px-3 py-2 bg-gray-200 rounded-lg mt-3"
        href={~p"/e/#{@event.code}/bingo"}
      >
        <span class="mr-3 text-lg font-bold">B</span>
        <span>{gettext("Bingo")}</span>
      </a>

      <a
        class="flex items-center px-3 py-2 bg-gray-200 rounded-lg mt-3"
        href={~p"/e/#{@event.code}"}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          class="h-5 w-5 mr-3"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
          />
        </svg>
        <span>{gettext("Back to event")}</span>
      </a>

      <a
        class="flex items-center px-3 py-2 bg-gray-200 rounded-lg mt-3"
        href={~p"/?disconnected_from=#{@event.uuid}"}
      >
        <img src="/images/icons/exit-outline.svg" class="h-5 mr-3" />
        <span>{gettext("Leave")}</span>
      </a>
    </div>
  </div>

  <div
    id="content"
    class="w-full bg-black fixed z-10 lg:w-1/3"
    style="box-shadow: 0px 15px 14px 1px rgba(0,0,0,0.35);"
  >
    <div class="flex justify-between items-center px-5 py-3">
      <button
        phx-click={toggle_side_menu()}
        class="bg-black rounded-full text-sm px-3 py-1 bg-linear-to-tl from-primary-500 to-secondary-500 bg-size-[200%_200%] bg-position-[0%_0%] text-white uppercase flex items-center"
      >
        <img src="/images/icons/menu-outline.svg" class="h-6" />
        <span class="ml-1">#{@event.code}</span>
      </button>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-white">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.8"
            stroke="currentColor"
            class="h-4 w-4 text-primary-400"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.75 3v2.25m10.5-2.25v2.25M3.75 9h16.5m-15.75-4.5h15A1.5 1.5 0 0 1 21 6v13.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19.5V6A1.5 1.5 0 0 1 4.5 4.5Z"
            />
          </svg>
          {gettext("Agenda")}
        </span>
        <a
          href={~p"/e/#{@event.code}"}
          aria-label={gettext("Back to event")}
          title={gettext("Back to event")}
          class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-gray-900 ring-1 ring-white/15 transition hover:bg-gray-800"
        >
          <img
            src="/images/icons/chatbubble-ellipses-outline.svg"
            class="h-4 w-4 brightness-0 invert"
            alt=""
          />
        </a>
      </div>
    </div>
  </div>

  <main class="agenda-main min-h-screen w-full bg-black px-4 pb-12 pt-20 lg:w-1/3 lg:px-5">
    <section class="relative overflow-hidden rounded-xl border border-white/10 bg-gray-900 px-5 py-5 text-white shadow-xl shadow-black/30">
      <span class="absolute inset-x-0 top-0 h-1 bg-linear-to-r from-primary-500 to-secondary-500">
      </span>
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <p class="text-sm font-medium text-gray-400">{@event.name}</p>
          <h1 class="mt-1 text-3xl font-bold tracking-tight">{gettext("Agenda")}</h1>
        </div>
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-primary-500 to-secondary-500 shadow-lg shadow-primary-950/40">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.8"
            stroke="currentColor"
            class="h-6 w-6"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.75 3v2.25m10.5-2.25v2.25M3.75 9h16.5m-15.75-4.5h15A1.5 1.5 0 0 1 21 6v13.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19.5V6A1.5 1.5 0 0 1 4.5 4.5Z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7.5 12.75h.008v.008H7.5v-.008Zm4.5 0h.008v.008H12v-.008Zm4.5 0h.008v.008H16.5v-.008ZM7.5 16.5h.008v.008H7.5V16.5Zm4.5 0h.008v.008H12V16.5Zm4.5 0h.008v.008H16.5V16.5Z"
            />
          </svg>
        </div>
      </div>
    </section>

    <%= if Enum.empty?(@agenda_items) do %>
      <div class="mt-4 rounded-b-xl rounded-tr-xl border border-dashed border-gray-700 bg-gray-900 p-6 text-center">
        <p class="font-semibold text-white">{gettext("No agenda items yet")}</p>
        <p class="mt-2 text-sm text-gray-400">
          {gettext("The agenda will appear here when it is published.")}
        </p>
      </div>
    <% else %>
      <div id="agenda-session-list" class="mt-4 space-y-3" phx-hook="AgendaFocus">
        <%= for agenda_item <- @agenda_items do %>
          <% speaker_images = Claper.Agendas.AgendaItem.image_list(agenda_item) %>
          <% speaker_profiles = Claper.Agendas.AgendaItem.speaker_profiles(agenda_item) %>
          <% speaker_panel? = length(speaker_profiles) > 2 %>
          <% moment = agenda_moment(agenda_item.title) %>
          <article
            id={"agenda-item-#{agenda_item.id}"}
            class="agenda-session relative overflow-hidden rounded-b-xl rounded-tr-xl bg-white px-4 py-4 pl-5 shadow-lg shadow-black/20"
            data-agenda-starts-at={NaiveDateTime.to_iso8601(agenda_item.starts_at) <> "Z"}
            data-agenda-duration={agenda_item.duration_minutes || 0}
          >
            <span
              data-agenda-accent
              class="absolute inset-y-0 left-0 w-1 bg-linear-to-b from-primary-500 to-secondary-500"
              aria-hidden="true"
            >
            </span>

            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex min-w-0 flex-wrap items-center gap-2">
                <div class="inline-flex items-center gap-2 text-sm font-semibold text-primary-700">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.8"
                    stroke="currentColor"
                    class="h-4 w-4 shrink-0"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                    />
                  </svg>
                  <time>{format_agenda_time(agenda_item.starts_at, @timezone)}</time>
                </div>
                <span data-agenda-live-badge class="agenda-live-badge" hidden>
                  <span class="agenda-live-badge__dot" aria-hidden="true"></span>
                  {gettext("Happening now")}
                </span>
              </div>
              <span
                :if={agenda_item.duration_minutes}
                class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600"
              >
                {format_duration(agenda_item.duration_minutes)}
              </span>
            </div>

            <h2 class="mt-3 text-lg font-bold leading-snug text-gray-950">{agenda_item.title}</h2>

            <div
              :if={speaker_profiles == [] && moment}
              data-agenda-moment={moment.kind}
              class={["agenda-moment", "agenda-moment--#{moment.kind}"]}
            >
              <span class="agenda-moment__icon-shell" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="agenda-moment__icon"
                  data-agenda-icon={moment.kind}
                >
                  <g
                    :if={moment.kind == "registration"}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 8h11v5.25A4.75 4.75 0 0 1 11.25 18h-1.5A4.75 4.75 0 0 1 5 13.25V8Z" />
                    <path d="M16 10h1.25a2.25 2.25 0 0 1 0 4.5H16M8 5.5c0-1 1-1.25 1-2.25M12 5.5c0-1 1-1.25 1-2.25M5 20h12" />
                  </g>
                  <g
                    :if={moment.kind == "networking-break"}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="9" cy="8" r="3" />
                    <path d="M3.5 19c.35-3.4 2.2-5.25 5.5-5.25S14.15 15.6 14.5 19M16.25 5.75a2.5 2.5 0 0 1 0 4.5M16 13.75c2.75 0 4.2 1.7 4.5 4.25" />
                  </g>
                  <g
                    :if={moment.kind == "under-30-awards"}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m8 3 4 5 4-5M12 8a6 6 0 1 1 0 12 6 6 0 0 1 0-12Z" />
                    <path d="m12 11 1 2.05 2.25.33-1.63 1.59.38 2.25-2-1.06-2 1.06.38-2.25-1.63-1.59 2.25-.33L12 11Z" />
                  </g>
                  <g
                    :if={moment.kind == "pitch-winner"}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M8 4h8v3.25C16 11 14.25 13 12 13s-4-2-4-5.75V4Z" />
                    <path d="M8 6H5v1.25c0 2.25 1.2 3.75 3.25 4.25M16 6h3v1.25c0 2.25-1.2 3.75-3.25 4.25M12 13v4M9 20h6M10 17h4" />
                  </g>
                  <g
                    :if={moment.kind == "networking-reception"}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m12 3 1.25 4.25L17.5 8.5l-4.25 1.25L12 14l-1.25-4.25L6.5 8.5l4.25-1.25L12 3Z" />
                    <path d="m18.5 14 .65 2.35 2.35.65-2.35.65L18.5 20l-.65-2.35L15.5 17l2.35-.65.65-2.35ZM5 3.5l.45 1.55L7 5.5l-1.55.45L5 7.5l-.45-1.55L3 5.5l1.55-.45L5 3.5Z" />
                  </g>
                </svg>
              </span>
              <span class="agenda-moment__copy">
                <span class="agenda-moment__eyebrow">{moment.eyebrow}</span>
                <span class="agenda-moment__label">{moment.label}</span>
              </span>
              <span class="agenda-moment__signal" aria-hidden="true"></span>
            </div>

            <%= if agenda_item.speaker_name do %>
              <%= if speaker_panel? do %>
                <div class="mt-4">
                  <div class="agenda-speaker-grid">
                    <div :for={profile <- speaker_profiles} class="agenda-speaker-card">
                      <img
                        :if={profile.image_url}
                        src={profile.image_url}
                        alt={profile.name}
                        loading="lazy"
                        onerror="this.style.display='none'"
                        class="agenda-speaker-portrait js-headshot"
                      />
                      <div class="agenda-speaker-meta">
                        <p class="agenda-speaker-name">{profile.name}</p>
                        <a
                          :if={profile.linkedin_url}
                          href={profile.linkedin_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="agenda-linkedin-link"
                          aria-label={gettext("Find %{name} on LinkedIn", name: profile.name)}
                          title={gettext("Find %{name} on LinkedIn", name: profile.name)}
                        >
                          <svg
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="agenda-linkedin-logo"
                            aria-hidden="true"
                          >
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 4.127 0c0 1.14-.925 2.065-2.064 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z" />
                          </svg>
                        </a>
                      </div>
                    </div>
                  </div>
                  <p
                    :if={speaker_detail(agenda_item) != ""}
                    class="mt-2.5 text-xs leading-5 text-gray-500"
                  >
                    {speaker_detail(agenda_item)}
                  </p>
                </div>
              <% else %>
                <div class="mt-3 flex items-center gap-2.5">
                  <span
                    :if={speaker_images != []}
                    class="flex max-w-full shrink-0 flex-wrap items-center gap-y-1"
                  >
                    <img
                      :for={url <- speaker_images}
                      src={url}
                      alt={agenda_item.speaker_name}
                      loading="lazy"
                      onerror="this.style.display='none'"
                      class="agenda-speaker-portrait agenda-speaker-portrait--compact js-headshot -ml-1.5 first:ml-0"
                    />
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-semibold leading-5 text-primary-700">
                      {agenda_item.speaker_name}
                    </p>
                    <%= if speaker_detail(agenda_item) != "" do %>
                      <p class="text-xs leading-5 text-gray-500">{speaker_detail(agenda_item)}</p>
                    <% end %>
                  </div>
                  <a
                    :for={profile <- speaker_profiles}
                    :if={profile.linkedin_url}
                    href={profile.linkedin_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="agenda-linkedin-link"
                    aria-label={gettext("Find %{name} on LinkedIn", name: profile.name)}
                    title={gettext("Find %{name} on LinkedIn", name: profile.name)}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="agenda-linkedin-logo"
                      aria-hidden="true"
                    >
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 4.127 0c0 1.14-.925 2.065-2.064 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z" />
                    </svg>
                  </a>
                </div>
              <% end %>
            <% end %>

            <div
              :if={agenda_item.track_name || agenda_item.location_name}
              class="mt-3 flex flex-wrap gap-2"
            >
              <span
                :if={agenda_item.track_name}
                class="rounded-full bg-primary-50 px-2.5 py-1 text-xs font-semibold text-primary-800"
              >
                {agenda_item.track_name}
              </span>
              <span
                :if={agenda_item.location_name}
                class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600"
              >
                {agenda_item.location_name}
              </span>
            </div>

            <%= if agenda_item.description do %>
              <p class="mt-3 whitespace-pre-line border-t border-gray-100 pt-3 text-sm leading-6 text-gray-600">
                {agenda_item.description}
              </p>
            <% end %>
          </article>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
