<div class="relative min-h-screen bg-gray-100 lg:flex lg:flex-col lg:items-center">
  <div class="relative w-full">
    <div
      id="side-menu-shadow"
      phx-click={toggle_side_menu()}
      class="hidden fixed z-20 h-screen bg-black/70 w-full"
    >
    </div>

    <div
      id="side-menu"
      class="hidden fixed h-screen w-64 bg-white rounded-r-lg flex z-30 px-4 flex-col justify-start lg:left-0 animate__faster"
    >
      <div>
        <img src="/images/hq-logo.png" class="h-20 my-3" />
        <span class="font-bold text-xl">{@event.name}</span>
      </div>

      <a
        class="flex items-center px-3 py-2 bg-primary-100 text-primary-800 rounded-lg mt-5"
        href={~p"/e/#{@event.code}/agenda"}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          class="h-5 w-5 mr-3"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"
          />
        </svg>
        <span>{gettext("Agenda")}</span>
      </a>

      <a
        class="flex items-center px-3 py-2 bg-gray-200 rounded-lg mt-3"
        href={~p"/e/#{@event.code}/bingo"}
      >
        <span class="mr-3 text-lg font-bold">B</span>
        <span>{gettext("Bingo")}</span>
      </a>

      <a
        class="flex items-center px-3 py-2 bg-gray-200 rounded-lg mt-3"
        href={~p"/e/#{@event.code}"}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          class="h-5 w-5 mr-3"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
          />
        </svg>
        <span>{gettext("Back to event")}</span>
      </a>

      <a
        class="flex items-center px-3 py-2 bg-gray-200 rounded-lg mt-3"
        href={~p"/?disconnected_from=#{@event.uuid}"}
      >
        <img src="/images/icons/exit-outline.svg" class="h-5 mr-3" />
        <span>{gettext("Leave")}</span>
      </a>
    </div>
  </div>

  <div
    id="content"
    class="w-full bg-black fixed z-10 lg:w-1/3"
    style="box-shadow: 0px 15px 14px 1px rgba(0,0,0,0.35);"
  >
    <div class="flex justify-between items-center px-5 py-3">
      <button
        phx-click={toggle_side_menu()}
        class="bg-black rounded-full text-sm px-3 py-1 bg-linear-to-tl from-primary-500 to-secondary-500 bg-size-[200%_200%] bg-position-[0%_0%] text-white uppercase flex items-center"
      >
        <img src="/images/icons/menu-outline.svg" class="h-6" />
        <span class="ml-1">#{@event.code}</span>
      </button>

      <span class="text-white text-sm font-semibold">{gettext("Agenda")}</span>
    </div>
  </div>

  <main class="w-full px-4 pb-10 pt-20 lg:w-1/3">
    <div class="bg-white rounded-xl shadow-sm p-5">
      <p class="text-sm text-gray-500">{@event.name}</p>
      <h1 class="text-2xl font-bold text-gray-900">{gettext("Agenda")}</h1>

      <%= if Enum.empty?(@agenda_items) do %>
        <div class="mt-8 rounded-lg border border-dashed border-gray-300 p-6 text-center">
          <p class="font-semibold text-gray-700">{gettext("No agenda items yet")}</p>
          <p class="mt-2 text-sm text-gray-500">
            {gettext("The agenda will appear here when it is published.")}
          </p>
        </div>
      <% else %>
        <div class="mt-8 space-y-6">
          <%= for agenda_item <- @agenda_items do %>
            <article class="relative border-l-2 border-primary-500 pl-5">
              <span class="absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-primary-500"></span>
              <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
                <time>{format_agenda_time(agenda_item.starts_at, @timezone)}</time>
                <%= if agenda_item.duration_minutes do %>
                  <span>&middot;</span>
                  <span>{format_duration(agenda_item.duration_minutes)}</span>
                <% end %>
              </div>
              <h2 class="mt-1 text-lg font-semibold text-gray-900">{agenda_item.title}</h2>
              <%= if agenda_item.speaker_name do %>
                <div class="mt-2 flex items-center gap-2.5">
                  <img
                    :if={agenda_item.speaker_image_url}
                    src={agenda_item.speaker_image_url}
                    alt=""
                    loading="lazy"
                    onerror="this.style.display='none'"
                    class="h-9 w-9 rounded-full object-cover border border-gray-200"
                  />
                  <div>
                    <p class="text-sm font-medium text-primary-700">
                      {agenda_item.speaker_name}
                    </p>
                    <%= if speaker_detail(agenda_item) != "" do %>
                      <p class="text-xs text-gray-500">{speaker_detail(agenda_item)}</p>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <%= if agenda_item.track_name || agenda_item.location_name do %>
                <p class="mt-1 text-sm text-gray-500">
                  {Enum.reject([agenda_item.track_name, agenda_item.location_name], &is_nil/1)
                  |> Enum.join(" · ")}
                </p>
              <% end %>
              <%= if agenda_item.description do %>
                <p class="mt-2 whitespace-pre-line text-sm leading-6 text-gray-600">
                  {agenda_item.description}
                </p>
              <% end %>
            </article>
          <% end %>
        </div>
      <% end %>
    </div>
  </main>
</div>
