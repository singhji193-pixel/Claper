<%= if @status == :not_found do %>
  <div class="nextgen-pwa" style="--pwa-primary: #f15a24; --pwa-accent: #365a91;">
    <main class="pwa-unavailable-shell">
      <section class="pwa-unavailable">
        <span class="pwa-unavailable-icon">
          <.pwa_icon name="hero-exclamation-triangle" class="size-7" />
        </span>
        <p class="pwa-eyebrow">{gettext("NextGen event app")}</p>
        <h1>{gettext("Event not found")}</h1>
        <p>
          {gettext(
            "Check the event code and try again. If you were invited, use the link from your ticket email."
          )}
        </p>
        <.link navigate={~p"/join"} class="pwa-primary-action pwa-focus">
          {gettext("Enter another code")}
        </.link>
      </section>
    </main>
  </div>
<% else %>
  <div class="nextgen-pwa" style={pwa_theme_style(@settings)}>
    <div class="pwa-shell">
      <header class="pwa-hero">
        <div class="pwa-brand-row">
          <div class="pwa-brand-mark">
            <img src="/images/favicon.png" alt="CoreOrbit" />
          </div>
          <div>
            <p class="pwa-eyebrow">{gettext("NextGen event app")}</p>
            <p class="pwa-code">#{String.upcase(@event.code)}</p>
          </div>
          <span class="pwa-status">{event_status(@event)}</span>
        </div>

        <div class="pwa-hero-copy">
          <h1>{@event.name}</h1>
          <p>{@settings.home_tagline}</p>
        </div>

        <div class="pwa-stat-grid" aria-label={gettext("Event app status")}>
          <.stat_pill
            icon="hero-calendar-days"
            value={format_event_time(@event.started_at)}
            label={gettext("Start")}
            tone="primary"
          />
          <.stat_pill
            icon="hero-list-bullet"
            value={feature_count(@bootstrap.features.agenda, gettext("item"), gettext("items"))}
            label={gettext("Agenda")}
            tone="accent"
          />
          <.stat_pill
            icon="hero-qr-code"
            value={
              feature_count(@bootstrap.features.bingo, gettext("prompt"), gettext("prompts"))
            }
            label={gettext("Bingo")}
            tone="neutral"
          />
        </div>

        <section :if={!signed_in?(@attendee)} class="pwa-auth-nudge">
          <span class="pwa-auth-nudge-icon">
            <.pwa_icon name="hero-envelope" class="size-6" />
          </span>
          <div>
            <strong>{gettext("Ticket login")}</strong>
            <span>
              {gettext("Use your event ticket email to unlock profile and networking.")}
            </span>
          </div>
          <.link href={~p"/app/#{@event.code}/login"} class="pwa-auth-nudge-action pwa-focus">
            {gettext("Sign in")}
          </.link>
        </section>

        <section :if={signed_in?(@attendee)} class="pwa-auth-nudge pwa-auth-nudge-signed-in">
          <span class="pwa-auth-nudge-icon">
            <.pwa_icon name="hero-ticket" class="size-6" />
          </span>
          <div>
            <strong>{attendee_display_name(@attendee)}</strong>
            <span>{@attendee.ticket_name || gettext("Ticket verified")}</span>
          </div>
          <.link href={~p"/app/#{@event.code}/profile"} class="pwa-auth-nudge-action pwa-focus">
            {gettext("Profile")}
          </.link>
        </section>
      </header>

      <main id="pwa-main" class="pwa-main" tabindex="-1">
        <%= case @live_action do %>
          <% :agenda -> %>
            <section class="pwa-section-header">
              <p class="pwa-eyebrow">{gettext("Schedule")}</p>
              <h2>{gettext("Agenda")}</h2>
              <p>
                {gettext("Browse sessions by day and track, then save the ones you care about.")}
              </p>
            </section>

            <%= if Enum.empty?(@agenda_items) do %>
              <section class="pwa-empty-state">
                <span class="pwa-empty-icon">
                  <.pwa_icon name="hero-calendar-days" class="size-7" />
                </span>
                <h3>{gettext("Agenda is being finalized")}</h3>
                <p>{gettext("The organizer has not published sessions for this event yet.")}</p>
              </section>
            <% else %>
              <section class="pwa-filter-group" aria-label={gettext("Agenda days")}>
                <.day_chip
                  :for={day <- @agenda_days}
                  event={@event}
                  day={day}
                  selected_day={@selected_day}
                />
              </section>

              <section
                :if={!Enum.empty?(@agenda_tracks)}
                class="pwa-filter-group"
                aria-label={gettext("Agenda tracks")}
              >
                <.track_chip
                  event={@event}
                  track="all"
                  selected_day={@selected_day}
                  selected_track={@selected_track}
                />
                <.track_chip
                  :for={track <- @agenda_tracks}
                  event={@event}
                  track={track}
                  selected_day={@selected_day}
                  selected_track={@selected_track}
                />
              </section>

              <section class="pwa-agenda-list">
                <%= if Enum.empty?(@visible_agenda_items) do %>
                  <section class="pwa-empty-state">
                    <span class="pwa-empty-icon">
                      <.pwa_icon name="hero-calendar-days" class="size-7" />
                    </span>
                    <h3>{gettext("No sessions match this filter")}</h3>
                    <p>{gettext("Try another day or track.")}</p>
                  </section>
                <% else %>
                  <.agenda_card
                    :for={item <- @visible_agenda_items}
                    event={@event}
                    item={item}
                    signed_in={signed_in?(@attendee)}
                    saved={saved_agenda_item?(@bookmarked_agenda_item_ids, item)}
                  />
                <% end %>
              </section>
            <% end %>
          <% :session -> %>
            <%= if @session_item do %>
              <section class="pwa-session-detail">
                <.link
                  navigate={
                    ~p"/app/#{@event.code}/agenda?day=#{@selected_day}&track=#{@selected_track}"
                  }
                  class="pwa-secondary-link pwa-focus"
                >
                  {gettext("Back to agenda")}
                </.link>

                <div class="pwa-session-detail-card">
                  <p
                    :if={@session_item.session_type || @session_item.track_name}
                    class="pwa-session-kicker"
                  >
                    {session_kicker(@session_item)}
                  </p>
                  <h2>{@session_item.title}</h2>
                  <p :if={@session_item.speaker_name} class="pwa-session-speaker">
                    {speaker_line(@session_item)}
                  </p>

                  <div class="pwa-session-meta pwa-session-meta-detail">
                    <span>
                      <.pwa_icon name="hero-calendar-days" class="size-4" />
                      {format_session_date(@session_item.starts_at)}
                    </span>
                    <span>
                      <.pwa_icon name="hero-clock" class="size-4" />
                      {format_agenda_time(@session_item.starts_at)} · {format_duration(
                        @session_item.duration_minutes
                      )}
                    </span>
                    <span :if={@session_item.location_name}>
                      <.pwa_icon name="hero-map-pin" class="size-4" />
                      {@session_item.location_name}
                    </span>
                  </div>

                  <p :if={@session_item.description} class="pwa-session-detail-description">
                    {@session_item.description}
                  </p>

                  <button
                    type="button"
                    phx-click="toggle-agenda-bookmark"
                    phx-value-id={@session_item.id}
                    class={[
                      "pwa-save-button pwa-save-button-wide pwa-focus",
                      saved_agenda_item?(@bookmarked_agenda_item_ids, @session_item) &&
                        "pwa-save-button-active"
                    ]}
                    aria-pressed={saved_agenda_item?(@bookmarked_agenda_item_ids, @session_item)}
                  >
                    <.pwa_icon
                      name={
                        if saved_agenda_item?(@bookmarked_agenda_item_ids, @session_item),
                          do: "hero-check-circle",
                          else: "hero-bookmark"
                      }
                      class="size-5"
                    />
                    <span>
                      {save_label(
                        saved_agenda_item?(@bookmarked_agenda_item_ids, @session_item),
                        signed_in?(@attendee)
                      )}
                    </span>
                  </button>
                </div>
              </section>
            <% else %>
              <section class="pwa-empty-state">
                <span class="pwa-empty-icon">
                  <.pwa_icon name="hero-exclamation-triangle" class="size-7" />
                </span>
                <h3>{gettext("Session not found")}</h3>
                <p>{gettext("This session may have been removed or moved.")}</p>
                <.link
                  navigate={~p"/app/#{@event.code}/agenda"}
                  class="pwa-primary-action pwa-focus"
                >
                  {gettext("Back to agenda")}
                </.link>
              </section>
            <% end %>
          <% :people -> %>
            <section class="pwa-section-header">
              <p class="pwa-eyebrow">{gettext("Networking")}</p>
              <h2>{gettext("People")}</h2>
              <p>
                {gettext(
                  "The attendee directory will use ticketed attendee profiles and opt-in sharing."
                )}
              </p>
            </section>

            <%= if signed_in?(@attendee) do %>
              <section class="pwa-empty-state">
                <span class="pwa-empty-icon">
                  <.pwa_icon name="hero-user-group" class="size-7" />
                </span>
                <h3>{gettext("People directory is next")}</h3>
                <p>
                  {gettext(
                    "Your ticket is verified. Search, QR connections, and contact sharing come in the networking phase."
                  )}
                </p>
              </section>
            <% else %>
              <section class="pwa-empty-state">
                <span class="pwa-empty-icon">
                  <.pwa_icon name="hero-envelope" class="size-7" />
                </span>
                <h3>{gettext("Sign in to view people")}</h3>
                <p>{gettext("Use your ticket email before networking tools open.")}</p>
                <.link href={~p"/app/#{@event.code}/login"} class="pwa-primary-action pwa-focus">
                  {gettext("Sign in")}
                </.link>
              </section>
            <% end %>
          <% :bingo -> %>
            <section class="pwa-section-header">
              <p class="pwa-eyebrow">{gettext("Networking game")}</p>
              <h2>{gettext("Bingo")}</h2>
              <p>
                {gettext(
                  "Your existing Bingo feature stays active while we bring it into the PWA experience."
                )}
              </p>
            </section>

            <%= if @bootstrap.features.bingo.count > 0 do %>
              <.feature_action
                icon="hero-qr-code"
                title={gettext("Open Bingo")}
                description={gettext("Play the current QR networking game for this event.")}
                meta={
                  feature_count(@bootstrap.features.bingo, gettext("prompt"), gettext("prompts"))
                }
                navigate={~p"/e/#{@event.code}/bingo"}
              />
            <% else %>
              <section class="pwa-empty-state">
                <span class="pwa-empty-icon">
                  <.pwa_icon name="hero-qr-code" class="size-7" />
                </span>
                <h3>{gettext("Bingo is not ready yet")}</h3>
                <p>{gettext("Organizer prompts will appear here when the game is ready.")}</p>
              </section>
            <% end %>
          <% :ticket -> %>
            <section class="pwa-section-header">
              <p class="pwa-eyebrow">{gettext("Wallet")}</p>
              <h2>{gettext("Ticket")}</h2>
              <p>
                {gettext("Your synced event pass for check-in and attendee verification.")}
              </p>
            </section>

            <%= if signed_in?(@attendee) && @ticket_wallet do %>
              <.ticket_wallet_card event={@event} wallet={@ticket_wallet} />
            <% else %>
              <section class="pwa-empty-state">
                <span class="pwa-empty-icon">
                  <.pwa_icon name="hero-ticket" class="size-7" />
                </span>
                <h3>{gettext("Sign in to view your ticket")}</h3>
                <p>{gettext("Use your ticket email to unlock your event pass.")}</p>
                <.link href={~p"/app/#{@event.code}/login"} class="pwa-primary-action pwa-focus">
                  {gettext("Sign in")}
                </.link>
              </section>
            <% end %>
          <% :profile -> %>
            <section class="pwa-section-header">
              <p class="pwa-eyebrow">{gettext("Account")}</p>
              <h2>{gettext("Profile")}</h2>
              <p>
                {gettext("Your event app access is tied to your synced ticket.")}
              </p>
            </section>

            <%= if signed_in?(@attendee) do %>
              <.ticket_wallet_card :if={@ticket_wallet} event={@event} wallet={@ticket_wallet} />

              <section class="pwa-profile-card">
                <span class="pwa-profile-avatar">
                  <.pwa_icon name="hero-user-circle" class="size-8" />
                </span>
                <div class="pwa-profile-main">
                  <p class="pwa-eyebrow">{gettext("Verified attendee")}</p>
                  <h3>{attendee_display_name(@attendee)}</h3>
                  <dl>
                    <div>
                      <dt>{gettext("Email")}</dt>
                      <dd>{@attendee.email}</dd>
                    </div>
                    <div>
                      <dt>{gettext("Ticket")}</dt>
                      <dd>{@attendee.ticket_name || gettext("Ticket verified")}</dd>
                    </div>
                  </dl>
                </div>
              </section>

              <.link
                navigate={~p"/app/#{@event.code}/ticket"}
                class="pwa-primary-action pwa-focus"
              >
                <.pwa_icon name="hero-identification" class="size-5" />
                {gettext("Open ticket")}
              </.link>

              <form action={~p"/app/#{@event.code}/session"} method="post" class="pwa-inline-form">
                <input type="hidden" name="_method" value="delete" />
                <input
                  type="hidden"
                  name="_csrf_token"
                  value={Phoenix.Controller.get_csrf_token()}
                />
                <button type="submit" class="pwa-secondary-action pwa-focus">
                  <.pwa_icon name="hero-arrow-right-on-rectangle" class="size-5" />
                  {gettext("Sign out")}
                </button>
              </form>
            <% else %>
              <section class="pwa-empty-state">
                <span class="pwa-empty-icon">
                  <.pwa_icon name="hero-envelope" class="size-7" />
                </span>
                <h3>{gettext("Sign in to create your profile")}</h3>
                <p>{gettext("Enter your ticket email and 4-digit code to continue.")}</p>
                <.link href={~p"/app/#{@event.code}/login"} class="pwa-primary-action pwa-focus">
                  {gettext("Sign in")}
                </.link>
              </section>
            <% end %>
          <% _ -> %>
            <section class="pwa-section-header">
              <p class="pwa-eyebrow">{gettext("Companion app")}</p>
              <h2>{gettext("Welcome")}</h2>
              <p>
                {gettext(
                  "Use the new app shell for schedule, networking, and live event tools as they come online."
                )}
              </p>
            </section>

            <section class="pwa-action-grid">
              <.feature_action
                icon="hero-calendar-days"
                title={gettext("Agenda")}
                description={gettext("Browse the event schedule in a mobile-first view.")}
                meta={
                  feature_count(@bootstrap.features.agenda, gettext("item"), gettext("items"))
                }
                navigate={~p"/app/#{@event.code}/agenda"}
              />
              <%= if signed_in?(@attendee) do %>
                <.feature_action
                  icon="hero-ticket"
                  title={gettext("Ticket")}
                  description={gettext("Open your synced event pass.")}
                  navigate={~p"/app/#{@event.code}/ticket"}
                />
              <% else %>
                <.feature_action
                  icon="hero-ticket"
                  title={gettext("Ticket")}
                  description={gettext("Sign in to unlock your ticket wallet.")}
                  href={~p"/app/#{@event.code}/login"}
                />
              <% end %>
              <.feature_action
                icon="hero-qr-code"
                title={gettext("Bingo")}
                description={gettext("Meet attendees with QR prompts and saved connections.")}
                meta={
                  feature_count(@bootstrap.features.bingo, gettext("prompt"), gettext("prompts"))
                }
                navigate={~p"/app/#{@event.code}/bingo"}
              />
              <.feature_action
                icon="hero-user-group"
                title={gettext("People")}
                description={
                  gettext(
                    "Attendee directory, search, and contact sharing are queued for the networking phase."
                  )
                }
                navigate={~p"/app/#{@event.code}/people"}
              />
              <.feature_action
                icon="hero-user-circle"
                title={gettext("Profile")}
                description={
                  if signed_in?(@attendee),
                    do: gettext("View your verified ticket profile."),
                    else: gettext("Sign in with your event ticket email.")
                }
                navigate={~p"/app/#{@event.code}/profile"}
              />
            </section>
        <% end %>
      </main>

      <nav class="pwa-bottom-nav" aria-label={gettext("Event app navigation")}>
        <.nav_item
          active={@live_action == :home}
          icon="hero-home"
          label={gettext("Home")}
          navigate={~p"/app/#{@event.code}"}
        />
        <.nav_item
          active={@live_action in [:agenda, :session]}
          icon="hero-calendar-days"
          label={gettext("Agenda")}
          navigate={~p"/app/#{@event.code}/agenda"}
        />
        <.nav_item
          active={@live_action == :people}
          icon="hero-user-group"
          label={gettext("People")}
          navigate={~p"/app/#{@event.code}/people"}
        />
        <.nav_item
          active={@live_action == :bingo}
          icon="hero-qr-code"
          label={gettext("Bingo")}
          navigate={~p"/app/#{@event.code}/bingo"}
        />
        <.nav_item
          active={@live_action in [:profile, :ticket]}
          icon="hero-user-circle"
          label={gettext("Profile")}
          navigate={~p"/app/#{@event.code}/profile"}
        />
      </nav>
    </div>
  </div>
<% end %>
