<div class="nextgen-summit-liveview" style={theme_style(@event)}>
  <main class="ngs-auth-shell ngs-auth-shell-reference">
    <nav class="ngs-auth-ref-nav" aria-label={gettext("Event app")}>
      <.link
        href={
          app_path(
            assigns,
            "/login?#{URI.encode_query(compact_params(email: @email, next: @next_path))}"
          )
        }
        class="ngs-auth-ref-link ngs-focus"
      >
        {gettext("Back")}
      </.link>
      <span class="ngs-auth-ref-pill">{gettext("OTP")}</span>
    </nav>

    <section class="ngs-auth-ref-panel" aria-labelledby="ngs-verify-title">
      <img src="/images/logo-large.png" class="ngs-auth-ref-logo" alt="CoreOrbit Ask" />

      <div class="ngs-auth-ref-copy">
        <p>{gettext("Check your email")}</p>
        <h1 id="ngs-verify-title">{gettext("Enter your code")}</h1>
        <span>{@email}</span>
      </div>

      <.form
        :let={f}
        for={@conn}
        action={app_path(assigns, "/verify")}
        as={:attendee}
        class="ngs-auth-ref-form"
      >
        <input type="hidden" name={f[:email].name} value={@email} />
        <input :if={@next_path} type="hidden" name={f[:next].name} value={@next_path} />

        <div :if={@error_message} class="ngs-auth-ref-error" role="alert">
          <.ngs_icon name="hero-exclamation-triangle" class="size-5" />
          <span>{@error_message}</span>
        </div>

        <label class="sr-only" for="attendee_code">{gettext("4-digit code")}</label>
        <div class="ngs-auth-ref-field">
          <.ngs_icon name="hero-identification" class="size-6" />
          <input
            id="attendee_code"
            name={f[:code].name}
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{4}"
            maxlength="4"
            required
            autofocus
            placeholder="0000"
            class="ngs-auth-ref-input ngs-auth-ref-code"
          />
        </div>

        <button type="submit" class="ngs-auth-ref-submit ngs-focus" disabled={!@event}>
          {gettext("Verify and continue")}
        </button>
      </.form>

      <.link
        href={
          app_path(
            assigns,
            "/login?#{URI.encode_query(compact_params(email: @email, next: @next_path))}"
          )
        }
        class="ngs-auth-ref-resend ngs-focus"
      >
        {gettext("Didn't get it?")} <span>{gettext("Resend code")}</span>
      </.link>
    </section>
  </main>
</div>
