<div class="nextgen-summit-liveview" style={theme_style(@event)}>
  <main class="ngs-auth-shell ngs-auth-shell-reference">
    <nav class="ngs-auth-ref-nav" aria-label={gettext("Event app")}>
      <a href="https://nextgensummit.co" class="ngs-auth-ref-link ngs-focus">
        {gettext("About")}
      </a>
      <span class="ngs-auth-ref-pill">{gettext("Event app")}</span>
    </nav>

    <section class="ngs-auth-ref-panel" aria-labelledby="ngs-login-title">
      <img src="/images/logo-large.png" class="ngs-auth-ref-logo" alt="CoreOrbit Ask" />

      <div class="ngs-auth-ref-copy">
        <p>{gettext("NextGen Summit")}</p>
        <h1 id="ngs-login-title">{gettext("Sign in with your ticket")}</h1>
      </div>

      <.form
        :let={f}
        for={@conn}
        action={app_path(assigns, "/login")}
        as={:attendee}
        class="ngs-auth-ref-form"
      >
        <input :if={@next_path} type="hidden" name={f[:next].name} value={@next_path} />

        <div :if={@error_message} class="ngs-auth-ref-error" role="alert">
          <.ngs_icon name="hero-exclamation-triangle" class="size-5" />
          <span>{@error_message}</span>
        </div>

        <label class="sr-only" for="attendee_email">{gettext("Ticket email")}</label>
        <div class="ngs-auth-ref-field">
          <.ngs_icon name="hero-envelope" class="size-6" />
          <input
            id="attendee_email"
            name={f[:email].name}
            value={@email}
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            autofocus
            placeholder={gettext("Ticket email")}
            class="ngs-auth-ref-input"
          />
        </div>

        <button type="submit" id="submit" class="ngs-auth-ref-submit ngs-focus" disabled={!@event}>
          {gettext("Send 4-digit code")}
        </button>
      </.form>

      <p class="ngs-auth-ref-note">
        {gettext("Access is limited to verified ticket holders.")}
      </p>
    </section>
  </main>
</div>
